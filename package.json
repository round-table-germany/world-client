{
  "name": "@round-table-germany/world-client",
  "version": "1.1.0",
  "description": "Client für die .WORLD-API von Round Table (Drossel, Wiederholung, Cache, Profil-/Vorstandsauswertung) samt Mock-Server für Tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/round-table-germany/world-client.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "world-mock": "./dist/mock/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node dist/mock/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fastify": "^5.12.8",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
